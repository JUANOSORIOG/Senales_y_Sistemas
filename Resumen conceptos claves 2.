        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.signal import hilbert\n",
        "\n",
        "# Crear una señal ejemplo: una senoide con frecuencia 5 Hz\n",
        "fs = 1000          # Frecuencia de muestreo 1000 Hz\n",
        "t = np.arange(0, 1, 1/fs)  # 1 segundo de duración\n",
        "f = 5              # frecuencia de la señal en Hz\n",
        "\n",
        "x = np.sin(2 * np.pi * f * t)\n",
        "\n",
        "# Calcular la Transformada de Hilbert usando scipy.signal.hilbert\n",
        "analytical_signal = hilbert(x)\n",
        "hilbert_transform = np.imag(analytical_signal)   # parte imaginaria es la Transformada de Hilbert\n",
        "envelope = np.abs(analytical_signal)             # envolvente de la señal\n",
        "\n",
        "# Graficar resultados\n",
        "plt.figure(figsize=(12, 6))\n",
        "\n",
        "plt.plot(t, x, label='Señal original (real)')\n",
        "plt.plot(t, hilbert_transform, label='Transformada de Hilbert (parte imaginaria)')\n",
        "plt.plot(t, envelope, label='Envolvente (módulo de la señal analítica)', linestyle='--')\n",
        "\n",
        "plt.title('Transformada de Hilbert - Ejemplo Práctico')\n",
        "plt.xlabel('Tiempo [s]')\n",
        "plt.ylabel('Amplitud')\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()"
